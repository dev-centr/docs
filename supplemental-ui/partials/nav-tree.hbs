{{#if navigation.length}}
<ul class="nav-list">
  {{#each navigation}}
  <li class="nav-item{{#if (eq ./url @root.page.url)}} is-current-page{{/if}}{{#if (nav-typology-id this level=(or ../level 0))}} has-nav-typology{{/if}}" data-depth="{{or ../level 0}}" data-nav-typology="{{nav-typology-id this level=(or ../level 0)}}">
    {{#if ./content}}
    {{#if ./items.length}}
    <button class="nav-item-toggle"></button>
    {{/if}}
    {{#if ./url}}
    <a class="nav-link" href="
      {{~#if (eq ./urlType 'internal')}}{{{relativize ./url}}}
      {{~else}}{{{./url}}}{{~/if}}">
      {{{nav-component-logo this}}}
      {{#if (nav-typology-id this level=(or ../level 0))}}
      {{#if ./navTypology}}
      <svg class="nav-typology-icon nav-typology-icon--{{./navTypology.id}}" width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"><use href="{{{uiRootPath}}}/img/nav-typology.svg#{{./navTypology.spriteId}}"/></svg>
      {{else}}
      {{{nav-typology-icon this level=(or ../level 0)}}}
      {{/if}}
      {{/if}}
      <span class="nav-text">{{#if (nav-typology-id this level=(or ../level 0))}}{{#if ./navTypology}}{{{./content}}}{{else}}{{{strip-nav-typology-emoji ./content}}}{{/if}}{{else}}{{{./content}}}{{/if}}</span>
    </a>
    {{else}}
    <span class="nav-text">
      {{{nav-component-logo this}}}
      {{#if (nav-typology-id this level=(or ../level 0))}}
      {{#if ./navTypology}}
      <svg class="nav-typology-icon nav-typology-icon--{{./navTypology.id}}" width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"><use href="{{{uiRootPath}}}/img/nav-typology.svg#{{./navTypology.spriteId}}"/></svg>
      {{else}}
      {{{nav-typology-icon this level=(or ../level 0)}}}
      {{/if}}
      {{/if}}
      <span class="nav-typology-label">{{#if (nav-typology-id this level=(or ../level 0))}}{{#if ./navTypology}}{{{./content}}}{{else}}{{{strip-nav-typology-emoji ./content}}}{{/if}}{{else}}{{{./content}}}{{/if}}</span>
    </span>
    {{/if}}
    {{/if}}
{{> nav-tree navigation=./items level=(increment ../level)}}
  </li>
  {{/each}}
</ul>
{{/if}}
