<footer class="footer">
  <div class="footer-related" aria-label="Related projects">
    <p class="footer-related-label">Related projects</p>
    <p class="footer-related-links">
      <a href="https://devcentr.org">DevCentr</a>
      ·
      <a href="https://openshellorg.github.io/">OpenShellOrg</a>
      ·
      <a href="https://github.com/dlang-supplemental">dlang-supplemental</a>
    </p>
  </div>
  {{> footer-build-stack}}
  <p>
    Built with <a href="https://antora.org" target="_blank" rel="noopener">Antora</a>{{#if antoraVersion}} <span class="antora-version">({{antoraVersion}})</span>{{/if}}.
    UI:
    {{#if site.keys.ui_bundle_name}}
    <a href="{{site.keys.ui_bundle_url}}" target="_blank" rel="noopener">{{site.keys.ui_bundle_name}}</a>
    {{else}}
    <a href="https://github.com/antora-supplemental/valentus-theme" target="_blank" rel="noopener">valentus-theme</a>
    {{/if}}
    (MIT){{#if site.keys.footerNote}}. <span class="site-footer-note">{{{site.keys.footerNote}}}</span>{{/if}}.
  </p>
</footer>
<script src="{{{uiRootPath}}}/js/site-mermaid.js" defer></script>
<script src="{{{uiRootPath}}}/js/site-math.js" defer></script>
<script src="{{{uiRootPath}}}/js/site-nav-tree-current.js" defer></script>
<script src="{{{uiRootPath}}}/js/site-doc-nav.js" defer></script>
