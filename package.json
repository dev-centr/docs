{
  "dependencies": {
    "@antora-supplemental/page-context": "github:antora-supplemental/page-context#v0.6.7",
    "@antora/lunr-extension": "^1.0.0-alpha.13",
    "@chenglou/pretext": "^0.0.4",
    "@antora-supplemental/asciidoctor-emoji-literals": "github:antora-supplemental/asciidoctor-emoji-literals#main",
    "asciidoctor-emoji": "^0.5.0",
    "asciidoctor-kroki": "^0.18.1"
  },
  "scripts": {
    "build": "antora antora-playbook-local.yml",
    "build:online": "antora --fetch antora-playbook.yml",
    "build:testing": "antora antora-playbook.testing.yml",
    "kroki:up": "docker compose -f docker-compose.kroki.yml up -d",
    "kroki:down": "docker compose -f docker-compose.kroki.yml down",
    "diagrams:generate": "node scripts/generate-themed-diagrams.mjs && node scripts/sync-themed-svg-runtime.mjs",
    "diagrams:check": "node scripts/generate-themed-diagrams.mjs --check && node scripts/sync-themed-svg-runtime.mjs --check",
    "themed-svg:runtime": "node scripts/sync-themed-svg-runtime.mjs",
    "maint:orphans": "orphan-finder --root ./docs --out ./build/orphan-finder",
    "maint:nav-drift": "nav-drift --root ./docs --require-in-nav --out ./build/nav-drift",
    "maint:stale": "stale-page --root ./docs --days 365 --out ./build/stale-page",
    "maint:pins": "playbook-pin-auditor --root . --playbook antora-playbook.yml",
    "maint:deep-links": "deep-link-contracts --config deep-link-contracts.yml --site-dir ./build/site",
    "test": "node --test test/*.test.js",
    "test:dark-text": "node --test test/verify-themed-svg-dark-mode.test.js"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
  "devDependencies": {
    "@antora-supplemental/deep-link-contracts": "github:antora-supplemental/deep-link-contracts#v0.1.0",
    "@antora-supplemental/facto-stack": "github:antora-supplemental/facto-stack#v0.2.16",
    "@antora-supplemental/link-validator": "github:antora-supplemental/link-validator#v0.2.2",
    "@antora-supplemental/nav-drift": "github:antora-supplemental/nav-drift#v0.1.0",
    "@antora-supplemental/orphan-finder": "github:antora-supplemental/orphan-finder#v0.1.1",
    "@antora-supplemental/playbook-pin-auditor": "github:antora-supplemental/playbook-pin-auditor#v0.1.0",
    "@antora-supplemental/site-nav-tree": "github:antora-supplemental/site-nav-tree#v0.6.7",
    "@antora-supplemental/soft-nav-page-toc": "github:antora-supplemental/soft-nav-page-toc#v0.1.6",
    "@antora-supplemental/stale-page": "github:antora-supplemental/stale-page#v0.1.0",
    "@antora-supplemental/triage-ux-kit": "github:antora-supplemental/triage-ux-kit#v0.1.0",
    "@biomejs/biome": "^2.3.11",
    "@dev-centr/mermaid-svg-css-vars": "0.1.3",
    "@dev-centr/themed-svg": "0.2.3",
    "@mermaid-js/mermaid-cli": "11.17.0",
    "antora": "^3.1.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ],
    "publicHoistPattern": [
      "@antora-supplemental/asciidoctor-emoji-literals",
      "asciidoctor-emoji"
    ]
  }
}
